# Kopieren nach .env.local (lokal) bzw. in Vercel unter Settings -> Environment Variables eintragen.

# Geheimer Zugangsschlüssel. Ohne ihn ist die Seite offen (nur für lokal/Demo!).
# Erzeugen z. B. mit:  openssl rand -base64 18 | tr '+/' '-_'
ZUGANG_TOKEN=

# Supabase (Project Settings -> API). Ohne diese Werte werden die Startdaten aus dem Repo angezeigt.
SUPABASE_URL=
# "Secret key" (sb_secret_…) bzw. der alte "service_role"-Schlüssel – NUR serverseitig verwenden!
SUPABASE_SECRET_KEY=
