# Kopieren nach .env.local (lokal) bzw. in Vercel unter Settings -> Environment Variables eintragen.

# Geheimer Zugangsschlüssel für die Seite und die Kalender-Abos.
# Ohne ihn ist die Seite offen (nur für lokal/Demo!).
# Erzeugen z. B. mit:  openssl rand -base64 18 | tr '+/' '-_'
ZUGANG_TOKEN=

# Passwort für die Verwaltung (Termine & Gruppen bearbeiten).
# Ohne Passwort darf jeder mit Zugang bearbeiten.
BEARBEITEN_TOKEN=

# Supabase (Project Settings -> API). Ohne diese Werte:
# - lokal: Änderungen werden in .daten/daten.json gespeichert
# - auf Vercel: nur Anzeige der Startdaten, Bearbeiten nicht möglich
SUPABASE_URL=
# "Secret key" (sb_secret_…) bzw. der alte "service_role"-Schlüssel – NUR serverseitig verwenden!
SUPABASE_SECRET_KEY=
