# Kopieren nach .env.local (lokal) bzw. in Vercel unter Settings -> Environment Variables eintragen.

# ── Datenbank ────────────────────────────────────────────────────────────────────
# Mit der Supabase-Integration in Vercel nicht nötig (POSTGRES_URL und SUPABASE_JWT_SECRET kommen automatisch).
# Sonst: Supabase → Connect → "Transaction pooler", Port 6543, Passwort einsetzen.
DATABASE_URL=
# Geheimer Schlüssel für Anmelde-Cookies (mind. 32 Zeichen). Ohne: SUPABASE_JWT_SECRET der Integration.
BETTER_AUTH_SECRET=

# ── Empfohlen ────────────────────────────────────────────────────────────────────
# Geheimer Zugangslink für die Ansicht und die Kalender-Abos (nur Buchstaben, Ziffern, -)
ZUGANG_TOKEN=
# E-Mail des Super-Admins – nur diese Adresse kann die Ersteinrichtung (/einrichtung) machen
SUPERADMIN_EMAIL=

# ── Optional ─────────────────────────────────────────────────────────────────────
# Öffentliche Adresse, falls eine eigene Domain genutzt wird (sonst automatisch von Vercel)
BETTER_AUTH_URL=
